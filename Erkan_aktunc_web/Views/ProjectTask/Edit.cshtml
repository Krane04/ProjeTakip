@model Erkan_aktunc_web.ViewModels.ProjectTaskViewModel

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">Görevi Düzenle</h5>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ProjectId" />

                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold">Başlık</label>
                        <input asp-for="Title" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Atanan Kişi</label>
                        <select asp-for="AssignedToId" class="form-select" asp-items="ViewBag.Members"></select>
                    </div>
                }
                else
                {
                    <input type="hidden" asp-for="Title" />
                    <input type="hidden" asp-for="Description" />
                    <input type="hidden" asp-for="AssignedToId" />

                    <div class="mb-3">
                        <h5>@Model.Title</h5>
                        <p class="text-muted">@Model.Description</p>
                    </div>
                }

                <div class="mb-4 bg-light p-3 rounded border">
                    <label class="form-label fw-bold text-primary">Durum (Statü)</label>
                    <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<Erkan_aktunc_web.Models.TaskStatus>()"></select>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a asp-controller="Projects" asp-action="Details" asp-route-id="@Model.ProjectId" class="btn btn-light">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>