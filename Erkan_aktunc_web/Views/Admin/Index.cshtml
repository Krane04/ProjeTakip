@model List<Erkan_aktunc_web.ViewModels.UserRoleViewModel>

<div class="container mt-4">
    <h2 class="mb-4">Kullanıcı Yönetimi</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow border-0">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Ad Soyad</th>
                        <th>Email</th>
                        <th>Mevcut Rol</th>
                        <th>Rol Değiştir</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge bg-secondary">@user.CurrentRole</span>
                            </td>
                            <td>
                                <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="userId" value="@user.UserId" />

                                    <select name="newRole" class="form-select form-select-sm" style="width: 120px;">
                                        <option value="Member" selected="@(user.CurrentRole == "Member")">Member</option>
                                        <option value="Manager" selected="@(user.CurrentRole == "Manager")">Manager</option>
                                        <option value="Admin" selected="@(user.CurrentRole == "Admin")">Admin</option>
                                    </select>

                                    <button type="submit" class="btn btn-sm btn-primary">Güncelle</button>
                                </form>

                                <form asp-action="DeleteUser" method="post" class="d-inline ms-2">
                                    <input type="hidden" name="userId" value="@user.UserId" />

                                    <button type="submit" class="btn btn-sm btn-danger"
                                            onclick="return confirm('@user.Email kullanıcısını silmek istediğinize emin misiniz? \nBu işlem geri alınamaz!');"
                                            title="Kullanıcıyı Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>