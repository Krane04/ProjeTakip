@model Erkan_aktunc_web.Models.ApplicationUser
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow">
        <div class="card-header bg-success text-white text-center">
            <h3>Kayıt Ol</h3>
        </div>
        <div class="card-body">
            <form asp-action="Register" method="post">
                <div class="row mb-3">
                    <div class="col">
                        <label class="form-label">Ad</label>
                        <input asp-for="FirstName" class="form-control" required />
                    </div>
                    <div class="col">
                        <label class="form-label">Soyad</label>
                        <input asp-for="LastName" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Şifre</label>
                    <input type="password" name="password" class="form-control" required minlength="3" />
                    <div class="form-text">En az 3 karakter (Test için basitleştirdik)</div>
                </div>

                <button type="submit" class="btn btn-success w-100">Kayıt Ol</button>

                <div class="text-danger mt-2" asp-validation-summary="All"></div>
            </form>
        </div>
        <div class="card-footer text-center">
            <small>Zaten hesabın var mı? <a asp-action="Login">Giriş Yap</a></small>
        </div>
    </div>
</div>